<!DOCTYPE html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      * { box-sizing: border-box; }
      body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #f5f6f8; margin: 0; color: #1f2937; }
      .bar { background: #1f2937; color: #fff; padding: 0 24px; display: flex; align-items: center; gap: 28px; height: 54px; }
      .brand { color: #fff; text-decoration: none; font-weight: 600; font-size: 16px; }
      .nav { display: flex; gap: 4px; flex: 1; }
      .nav-link { color: #cbd5e1; text-decoration: none; padding: 6px 12px; border-radius: 6px; font-size: 14px; }
      .nav-link.on { color: #fff; background: #2563eb; }
      .wrap { max-width: 640px; margin: 0 auto; padding: 24px 20px; }
      .card { background: #fff; border-radius: 10px; padding: 28px 30px; box-shadow: 0 1px 6px rgba(0,0,0,.06); }
      label { display: block; font-size: 14px; color: #374151; margin-bottom: 6px; font-weight: 500; }
      .field { margin-bottom: 18px; }
      input, textarea, select { width: 100%; padding: 9px 11px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; font-family: inherit; background: #fff; }
      input:focus, textarea:focus, select:focus { outline: none; border-color: #2563eb; }
      textarea { height: 90px; resize: vertical; }
      .error { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 10px 12px; border-radius: 6px; font-size: 14px; margin-bottom: 18px; }
      .actions { display: flex; gap: 10px; }
      .btn { padding: 9px 18px; border-radius: 6px; text-decoration: none; font-size: 14px; border: none; cursor: pointer; display: inline-block; }
      .btn-primary { background: #2563eb; color: #fff; }
      .btn-ghost { background: #f3f4f6; color: #374151; }
      .btn:hover { opacity: .9; }
      .req { color: #dc2626; }
      .opt { color: #9ca3af; font-weight: 400; font-size: 12px; }
      .hint { font-size: 12px; color: #9ca3af; margin-top: 6px; }
      .hint a { color: #2563eb; text-decoration: none; }
      .hint a:hover { text-decoration: underline; }
      .picked { margin-top: 8px; padding: 8px 12px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 6px; font-size: 13px; color: #075985; }
      .empty-wrap { text-align: center; padding: 60px 20px; }
      .empty-box { background: #fff; border-radius: 12px; padding: 40px 44px; box-shadow: 0 1px 6px rgba(0,0,0,.06); }
      .empty-box h2 { margin: 0 0 10px; font-size: 19px; }
      .empty-box p { color: #6b7280; margin: 0 0 22px; }
    </style>
  </head>
  <body>
    <%- include("partials/nav", { active: "demand" }) %>

    <div class="wrap">
      <div class="card">
        <% if (error) { %>
          <div class="error"><%= error %></div>
        <% } %>

        <form method="post" action="<%= action %>">
          <div class="field">
            <label>客户 <span class="req">*</span></label>
            <select name="profileId" required>
              <option value="" <%= !values.profileId ? "selected" : "" %>>— 请选择客户档案 —</option>
              <% profiles.forEach(function (p) { %>
                <option value="<%= p.id %>" <%= String(values.profileId) === String(p.id) ? "selected" : "" %>>
                  <%= p.companyName %>（<%= p.contactName %> · <%= p.phone %>）
                </option>
              <% }) %>
            </select>
            <div class="hint">
              需求必须挂在一个客户档案下。
              列表里没有？<a href="/profiles/new">先去建档</a>
              或<a href="/profiles">查看全部客户</a>。
            </div>
          </div>

          <div class="field">
            <label>需求描述 <span class="req">*</span></label>
            <textarea name="demand" placeholder="客户想要什么？预算、时间要求等"><%= values.demand %></textarea>
          </div>

          <div class="field">
            <label>状态 <span class="req">*</span></label>
            <select name="status">
              <% statuses.forEach(function (s) { %>
                <option value="<%= s %>" <%= s === values.status ? "selected" : "" %>><%= s %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label>备注 <span class="opt">选填</span></label>
            <textarea name="remark" placeholder="内部备注、跟进情况、决策链等"><%= values.remark %></textarea>
          </div>

          <div class="actions">
            <button type="submit" class="btn btn-primary"><%= submitText %></button>
            <a href="<%= values.id ? "/demands/" + values.id : "/" %>" class="btn btn-ghost">取消</a>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
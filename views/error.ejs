<!DOCTYPE html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= status %> <%= title %></title>
    <style>
      * { box-sizing: border-box; }
      body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #f5f6f8; margin: 0; color: #1f2937; }
      .box { max-width: 720px; margin: 80px auto; padding: 0 20px; }
      .card { background: #fff; border-radius: 12px; padding: 40px 44px; box-shadow: 0 1px 6px rgba(0,0,0,.06); }
      .code { font-size: 56px; font-weight: 700; color: #dc2626; line-height: 1; margin: 0; }
      h1 { font-size: 20px; margin: 12px 0 8px; }
      p { color: #6b7280; margin: 0 0 24px; }
      a { color: #2563eb; text-decoration: none; font-size: 14px; }
      details { margin-top: 24px; }
      summary { cursor: pointer; color: #6b7280; font-size: 13px; }
      pre { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; overflow-x: auto; font-size: 12px; color: #374151; margin-top: 10px; }
    </style>
  </head>
  <body>
    <div class="box">
      <div class="card">
        <p class="code"><%= status %></p>
        <h1><%= title %></h1>
        <p><%= message %></p>
        <a href="/">&larr; 返回需求列表</a>

        <% if (stack) { %>
          <details>
            <summary>查看技术细节（仅开发环境可见）</summary>
            <pre><%= stack %></pre>
          </details>
        <% } %>
      </div>
    </div>
  </body>
</html>
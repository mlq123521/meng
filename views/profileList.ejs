<!DOCTYPE html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>客户档案</title>
    <style>
      * { box-sizing: border-box; }
      body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #f5f6f8; margin: 0; color: #1f2937; }
      .bar { background: #1f2937; color: #fff; padding: 0 24px; display: flex; align-items: center; gap: 28px; height: 54px; }
      .brand { color: #fff; text-decoration: none; font-weight: 600; font-size: 16px; white-space: nowrap; }
      .nav { display: flex; gap: 4px; flex: 1; }
      .nav-link { color: #cbd5e1; text-decoration: none; padding: 6px 12px; border-radius: 6px; font-size: 14px; }
      .nav-link:hover { color: #fff; background: #374151; }
      .nav-link.on { color: #fff; background: #2563eb; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 24px 20px; }
      .card { background: #fff; border-radius: 10px; box-shadow: 0 1px 6px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 16px; }
      .filter { padding: 16px 18px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
      .filter input[type=text], .filter select { padding: 8px 11px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; font-family: inherit; background: #fff; }
      .filter input[type=text] { flex: 1; min-width: 200px; }
      .filter input:focus, .filter select:focus { outline: none; border-color: #2563eb; }
      .btn { display: inline-block; padding: 8px 14px; border-radius: 6px; text-decoration: none; font-size: 14px; border: none; cursor: pointer; white-space: nowrap; }
      .btn-primary { background: #2563eb; color: #fff; }
      .btn-ghost { background: #f3f4f6; color: #374151; }
      .btn-sm { padding: 4px 10px; font-size: 13px; }
      .bar .btn { padding: 6px 12px; font-size: 13px; }
      .bar .btn-ghost { background: #374151; color: #fff; }
      .btn:hover { opacity: .9; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
      th { background: #fafafa; color: #6b7280; font-weight: 500; }
      tr:last-child td { border-bottom: none; }
      tr:hover td { background: #fcfcfd; }
      .empty { text-align: center; color: #9ca3af; padding: 48px 0; }
      .tag { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; background: #eef2ff; color: #4338ca; white-space: nowrap; }
      .muted { color: #9ca3af; font-size: 13px; }
      .foot { text-align: center; }
      .row-actions { white-space: nowrap; }
      /* 备注：单行省略 */
      .remark-cell {
        display: block; max-width: 180px; overflow: hidden;
        text-overflow: ellipsis; white-space: nowrap; cursor: help;
      }
      .btn-link { background: none; border: none; color: #2563eb; cursor: pointer; font-size: 13px; padding: 2px 6px; text-decoration: none; }
      .btn-link:hover { text-decoration: underline; }
      .btn-link.danger { color: #dc2626; }
      .pager { display: flex; justify-content: center; align-items: center; gap: 6px; padding: 16px; flex-wrap: wrap; }
      .pager a, .pager span { min-width: 32px; height: 32px; padding: 0 10px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; text-decoration: none; color: #374151; background: #fff; border: 1px solid #e5e7eb; }
      .pager a:hover { border-color: #2563eb; color: #2563eb; }
      .pager .current { background: #2563eb; border-color: #2563eb; color: #fff; }
      .pager .disabled { color: #c9ccd1; background: #f9fafb; }
    </style>
  </head>
  <body>
    <%- include("partials/nav", {
      active: "profile",
      actions: '<a class="btn btn-ghost" href="/profiles/import">批量导入</a>'
        + '<a class="btn btn-ghost" href="' + exportLink + '">导出 CSV</a>'
        + '<a class="btn btn-primary" href="/profiles/new">+ 新建档案</a>',
    }) %>

    <div class="wrap">
      <div class="card">
        <form class="filter" method="get" action="/profiles">
          <input type="text" name="keyword" value="<%= keyword %>" placeholder="搜索公司 / 联系人 / 手机 / 邮箱 / 职位" />
          <select name="source">
            <option value="">全部来源</option>
            <% sources.forEach(function (s) { %>
              <option value="<%= s %>" <%= s === source ? "selected" : "" %>><%= s %></option>
            <% }) %>
          </select>
          <select name="industry">
            <option value="">全部行业</option>
            <% industries.forEach(function (i) { %>
              <option value="<%= i %>" <%= i === industry ? "selected" : "" %>><%= i %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-primary">查询</button>
          <a href="/profiles" class="btn btn-ghost">重置</a>
        </form>
      </div>

      <div class="card">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>公司名称</th>
              <th>联系人</th>
              <th>职位</th>
              <th>手机</th>
              <th>邮箱</th>
              <th>行业</th>
              <th>来源</th>
              <th>备注</th>
              <th>建档时间</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% if (list.length === 0) { %>
              <tr>
                <td colspan="11" class="empty">
                  <% if (keyword || source || industry) { %>
                    没有匹配的档案<br /><a href="/profiles">清空筛选条件</a>
                  <% } else { %>
                    还没有客户档案<br /><a href="/profiles/new">点右上角「+ 新建档案」</a> 建第一份
                  <% } %>
                </td>
              </tr>
            <% } %>

            <% list.forEach(function (p) { %>
              <tr>
                <td><%= p.id %></td>
                <td><a href="/profiles/<%= p.id %>"><strong><%= p.companyName %></strong></a></td>
                <td><%= p.contactName %></td>
                <td><% if (p.position) { %><%= p.position %><% } else { %><span class="muted">—</span><% } %></td>
                <td><%= p.phone %></td>
                <td><% if (p.email) { %><%= p.email %><% } else { %><span class="muted">—</span><% } %></td>
                <td><% if (p.industry) { %><%= p.industry %><% } else { %><span class="muted">—</span><% } %></td>
                <td><span class="tag"><%= p.source %></span></td>
                <td style="max-width:180px;">
                  <% if (p.remark) { %>
                    <span class="remark-cell" title="<%= p.remark %>"><%= p.remark %></span>
                  <% } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
                <td class="muted"><%= p.createdAt.toISOString().slice(0, 10) %></td>
                <td class="row-actions">
                  <a class="btn-link" href="/profiles/<%= p.id %>">详情</a>
                  <a class="btn-link" href="/profiles/<%= p.id %>/edit">编辑</a>
                  <form method="post" action="/profiles/<%= p.id %>/delete" style="display:inline;">
                    <button
                      type="submit"
                      class="btn-link danger"
                      onclick="return confirm('确定删除「<%= p.companyName %>」这份档案吗？')"
                    >删除</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <p class="muted foot">
        <% if (keyword || source || industry) { %>
          筛选出 <%= total %> 份 / 共 <%= allTotal %> 份
        <% } else { %>
          共 <%= total %> 份客户档案
        <% } %>
        <% if (totalPages > 1) { %>，第 <%= page %> / <%= totalPages %> 页<% } %>
      </p>

      <% if (totalPages > 1) { %>
        <div class="pager">
          <% if (prevLink) { %><a href="<%= prevLink %>">上一页</a><% } else { %><span class="disabled">上一页</span><% } %>
          <% pages.forEach(function (n) { %>
            <% if (n === page) { %><span class="current"><%= n %></span>
            <% } else { %><a href="/profiles?keyword=<%= encodeURIComponent(keyword) %>&source=<%= encodeURIComponent(source) %>&industry=<%= encodeURIComponent(industry) %>&page=<%= n %>"><%= n %></a><% } %>
          <% }) %>
          <% if (nextLink) { %><a href="<%= nextLink %>">下一页</a><% } else { %><span class="disabled">下一页</span><% } %>
        </div>
      <% } %>
    </div>
  </body>
</html>
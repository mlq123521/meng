<!DOCTYPE html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>需求详情</title>
    <link rel="stylesheet" href="/partials/table.css" />
  </head>
  <body>
    <div class="bar"><h1>需求详情</h1></div>

    <div class="wrap">
      <div class="card">
        <div class="head">
          <div>
            <h2><%= demand.companyName %></h2>
            <div class="no">需求编号 #<%= demand.id %></div>
          </div>
          <span class="tag"><%= demand.status %></span>
        </div>

        <hr class="sep" />

        <dl class="detail">
          <dt>客户</dt><dd><a href="/profiles/<%= demand.profileId %>" style="color:#2563eb;text-decoration:none;"><%= demand.companyName %></a></dd>
          <dt>联系人</dt><dd><%= demand.contactName %></dd>
          <dt>手机</dt><dd><%= demand.phone %></dd>
          <dt>需求描述</dt><dd class="pre"><%= demand.demand %></dd>
          <dt>备注</dt><dd class="pre"><% if (demand.remark) { %><%= demand.remark %><% } else { %><span class="muted">—</span><% } %></dd>
          <dt>登记时间</dt><dd><%= demand.createdAt.toISOString().slice(0, 19).replace("T", " ") %></dd>
        </dl>

        <hr class="sep" />

        <div class="actions" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
          <a class="btn btn-primary" href="/demands/<%= demand.id %>/edit">编辑</a>
          <a class="btn btn-ghost" href="/">返回列表</a>

          <form method="post" action="/demands/<%= demand.id %>/delete">
            <button
              type="submit"
              class="btn btn-danger"
              onclick="return confirm('确定删除这条需求吗？此操作不可恢复。')"
            >删除</button>
          </form>

          <a class="link-muted" href="/">共</a>
        </div>
      </div>
    </div>
  </body>
</html>
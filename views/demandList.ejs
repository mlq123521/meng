<!DOCTYPE html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>需求登记</title>
    <link rel="stylesheet" href="/partials/table.css" />
  </head>
  <body>
    <%- include("partials/nav", {
          active: "demand",
          actions: '<a class="btn btn-ghost" href="/export.csv">导出 CSV</a><a class="btn btn-primary" href="/new">+ 登记需求</a>',
        }) %>

    <div class="wrap">
      <!-- 搜索 / 筛选 -->
      <div class="card">
        <form class="filter" method="get" action="/">
          <input type="text" name="keyword" value="<%= keyword %>" placeholder="搜索客户名 / 联系人 / 手机 / 需求描述" />
          <select name="status">
            <option value="">全部状态</option>
            <% statuses.forEach(function (s) { %>
              <option value="<%= s %>" <%= s === status ? "selected" : "" %>><%= s %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-primary">查询</button>
          <a href="/" class="btn btn-ghost">重置</a>
        </form>
      </div>

      <!-- 列表 -->
      <div class="card">
        <!-- 窄屏横向滚动，而不是压缩列宽（压缩会把中文挤成竖排） -->
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th class="col-num" style="width: 56px;">ID</th>
                <th style="width: 22%;">客户</th>
                <th style="width: 90px;">联系人</th>
                <th style="width: 120px;">手机</th>
                <th style="width: 30%;">需求描述</th>
                <th style="width: 92px;">状态</th>
                <th class="col-opt" style="width: 18%;">备注</th>
                <th class="col-mono col-opt" style="width: 132px;">登记时间</th>
                <th class="actions-cell" style="width: 130px;">操作</th>
              </tr>
            </thead>
            <tbody>
              <% if (list.length === 0) { %>
                <tr>
                  <td colspan="9" class="empty">
                    <% if (keyword || status) { %>
                      没有匹配的需求记录<br />
                      <a href="/">清空筛选条件</a>
                    <% } else { %>
                      还没有需求记录<br />
                      <a href="/new">点右上角「+ 登记需求」</a> 录入第一条
                    <% } %>
                  </td>
                </tr>
              <% } %>

              <% list.forEach(function (d) { %>
                <tr>
                  <td class="col-num muted"><%= d.id %></td>
                  <td>
                    <a href="/profiles/<%= d.profileId %>" style="color:#2563eb;text-decoration:none;"><strong><%= d.companyName %></strong></a>
                  </td>
                  <td><%= d.contactName %></td>
                  <td class="col-mono"><%= d.phone %></td>
                  <td class="cell-clip">
                    <!-- 摘要：单行显示，超出部分截断；鼠标悬停看全文 -->
                    <span class="clip" title="<%= d.demand %>"><%= d.demandSummary %></span>
                    <% if (d.demandLines > 1) { %>
                      <span class="line-hint"><%= d.demandLines %> 行</span>
                    <% } %>
                  </td>
                  <td><span class="tag"><%= d.status %></span></td>
                  <td class="cell-clip-sm col-opt">
                    <% if (d.remark) { %>
                      <span class="clip" title="<%= d.remark %>"><%= d.remarkSummary %></span>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                  <td class="col-mono muted col-opt"><%= d.createdAt.toISOString().slice(0, 16).replace("T", " ") %></td>
                  <td class="actions-cell">
                    <a class="btn-link" href="/demands/<%= d.id %>">详情</a>
                    <a class="btn-link" href="/demands/<%= d.id %>/edit">编辑</a>
                    <form method="post" action="/demands/<%= d.id %>/delete" style="display: inline;">
                      <button
                        type="submit"
                        class="btn-link danger"
                        onclick="return confirm('确定删除「<%= d.companyName %>」的这条需求吗？此操作不可恢复。')"
                      >删除</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <p class="muted foot">
        <% if (keyword || status) { %>
          筛选出 <%= total %> 条 / 共 <%= allTotal %> 条
        <% } else { %>
          共 <%= total %> 条需求记录
        <% } %>
        <% if (totalPages > 1) { %>
          ，第 <%= page %> / <%= totalPages %> 页
        <% } %>
      </p>

      <!-- 分页控件 -->
      <% if (totalPages > 1) { %>
        <div class="pager">
          <% if (prevLink) { %>
            <a href="<%= prevLink %>">上一页</a>
          <% } else { %>
            <span class="disabled">上一页</span>
          <% } %>

          <% pages.forEach(function (p) { %>
            <% if (p === page) { %>
              <span class="current"><%= p %></span>
            <% } else { %>
              <a href="/?keyword=<%= encodeURIComponent(keyword) %>&status=<%= encodeURIComponent(status) %>&page=<%= p %>"><%= p %></a>
            <% } %>
          <% }) %>

          <% if (nextLink) { %>
            <a href="<%= nextLink %>">下一页</a>
          <% } else { %>
            <span class="disabled">下一页</span>
          <% } %>
        </div>
      <% } %>
    </div>
  </body>
</html>
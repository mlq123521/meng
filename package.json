{
  "name": "mytest",
  "description": "客户管理系统 —— Bun + Express + EJS + Drizzle ORM + PostgreSQL 的 MVC 分层实践项目",
  "module": "index.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "cli": "bun run cli/index.ts",
    "mcp": "bun run --env-file=.env mcp/server.ts",
    "test": "bun run test/smoke.ts",
    "test:mcp": "bun run test/mcp.test.ts",
    "test:smoke": "bun run test/smoke.ts",
    "test:import": "bun run test/import.test.ts",
    "test:atomic": "bun run test/atomic.test.ts",
    "test:batch": "bun run test/batch.test.ts",
    "test:cli": "bun run test/cli.test.ts",
    "test:all": "bun run test/smoke.ts && bun run test/import.test.ts && bun run test/atomic.test.ts && bun run test/batch.test.ts && bun run test/cli.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "multer": "^2.4.0"
  }
}
